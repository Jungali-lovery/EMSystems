# EMSystems server and sandbox payment gateway configuration.
# On a real deployment, keep this file private and never commit .env or production secrets.
APP_API_PORT=5176
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set true in production (also implied by NODE_ENV=production) to use Secure __Host- cookie.
EMSYSTEMS_SECURE_COOKIES=false
# Mock payment completion is disabled by default and is always disabled in production.
EMSYSTEMS_ALLOW_MOCK_PAYMENT=false
# Optional one-time first-admin bootstrap password (12–200 characters). Remove after first setup.
EMSYSTEMS_BOOTSTRAP_ADMIN_PASSWORD=
# Enable both only after Twilio Verify and the consent UI are configured/tested.
EMSYSTEMS_REQUIRE_PHONE_VERIFICATION=false
EMSYSTEMS_REQUIRE_DATA_CONSENT=false
# Public legal/policy contact values. Do not leave placeholder values on a public launch.
EMSYSTEMS_LEGAL_OPERATOR_NAME=
EMSYSTEMS_LEGAL_TAX_CODE=
EMSYSTEMS_LEGAL_BUSINESS_REGISTRATION=
EMSYSTEMS_LEGAL_BUSINESS_REGISTRATION_DATE=
EMSYSTEMS_LEGAL_BUSINESS_REGISTRATION_ISSUER=
EMSYSTEMS_LEGAL_REGISTERED_ADDRESS=
EMSYSTEMS_LEGAL_REPRESENTATIVE_NAME=
EMSYSTEMS_LEGAL_REPRESENTATIVE_TITLE=
EMSYSTEMS_LEGAL_HOTLINE=
EMSYSTEMS_LEGAL_EMAIL=
EMSYSTEMS_ECOMMERCE_NOTICE_ID=
EMSYSTEMS_ECOMMERCE_BADGE_URL=

# Transactional email and password reset (Resend). Verify the sender domain before enabling.
RESEND_API_KEY=
EMSYSTEMS_EMAIL_FROM=
EMSYSTEMS_PUBLIC_URL=http://127.0.0.1:5173

# Twilio Verify OTP and optional transactional SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM=

# Zalo OA/ZNS transactional template. Template fields must match templateData in communication-service.mjs.
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_ACCESS_TOKEN_EXPIRES_AT=
ZALO_ZNS_APP_ID=
ZALO_ZNS_APP_SECRET=
ZALO_ZNS_REFRESH_TOKEN=
ZALO_ZNS_TEMPLATE_ID_ORDER=
# Private rotated token cache (must be writable only by the emsystems service user).
EMSYSTEMS_ZALO_TOKEN_STATE_FILE=.emsystems-data/zalo-zns-token.json

# S3-compatible off-site encrypted backups (Cloudflare R2 or Amazon S3).
# `npm run backup:cloud` creates an encrypted local snapshot and uploads only *.enc + manifest.json.
EMSYSTEMS_S3_ENDPOINT=
EMSYSTEMS_S3_BUCKET=
EMSYSTEMS_S3_REGION=auto
EMSYSTEMS_S3_ACCESS_KEY_ID=
EMSYSTEMS_S3_SECRET_ACCESS_KEY=
EMSYSTEMS_S3_PREFIX=emsystems/backups

# Generic operational alert webhook (Slack/Teams/Discord/custom receiver).
# Payload contains service, status, method/path and timestamp only; no request body or secrets.
EMSYSTEMS_ALERT_WEBHOOK_URL=
EMSYSTEMS_ALERT_WEBHOOK_TOKEN=

# E-invoice is disabled until a tax-registered seller/provider account is configured.
EMSYSTEMS_EINVOICE_PROVIDER=none
# Optional absolute path to a private persistent SQLite file. Default: .emsystems-data/emsystems.sqlite
# EMSYSTEMS_DB_PATH=/var/lib/emsystems/emsystems.sqlite

PAYMENT_PORT=5175
PAYMENT_FRONTEND_URL=http://127.0.0.1:5173
# Generate one random secret (at least 32 characters) and set the identical value in private .env.
# It is shared only by the local payment service and the local business API; never place it in Vite/VITE_* variables.
PAYMENT_SERVICE_TOKEN=
# Payment status lookup from Business API to payment service; loopback only.
PAYMENT_API_INTERNAL_URL=http://127.0.0.1:5175
# Internal loopback business API; do not point this at a public/untrusted host.
APP_API_INTERNAL_URL=http://127.0.0.1:5176
# Optional private payment state directory; relative paths are resolved from the project root.
PAYMENT_STATE_DIR=.payment-sandbox-data
# Public HTTPS tunnel/domain forwarding to 127.0.0.1:5175. Required for provider callbacks.
PAYMENT_PUBLIC_BASE_URL=https://YOUR-PUBLIC-HTTPS-TUNNEL

# Private local backups. Keep this directory outside any web server document root.
EMSYSTEMS_BACKUP_DIR=.emsystems-backups
EMSYSTEMS_BACKUP_RETENTION=14
# Required 32-byte AES-256-GCM key (64 hex characters). Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key outside the backup directory and store a recovery copy in a secrets manager.
EMSYSTEMS_BACKUP_ENCRYPTION_KEY=

# MoMo Test credentials from the MoMo Business sandbox portal.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=EMSystems
MOMO_STORE_ID=EMSystemsSandbox

# VNPAY sandbox credentials from the VNPAY sandbox portal.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Must match the Return URL registered with VNPAY. Local URL can help inspect URL-generation code,
# but it is not a public production callback and does not by itself confirm a successful payment.
VNPAY_RETURN_URL=http://127.0.0.1:5173/api/payments/vnpay/return
# Set true only after configuring this exact URL in VNPAY merchant settings:
# https://YOUR-PUBLIC-HTTPS-TUNNEL/api/payments/vnpay/ipn
VNPAY_IPN_CONFIGURED=false

# VietQR receiving bank account is managed in Admin → Quản trị hệ thống → Tài khoản ngân hàng.
# It is stored in the server-side SQLite data snapshot, not in this environment file.

# Optional public MoMo IPN URL; otherwise the sandbox service derives it from PAYMENT_PUBLIC_BASE_URL.
MOMO_IPN_URL=