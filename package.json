{
  "name": "emsystems",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EMSystems electronics retail platform with a Node.js API, SQLite persistence, atomic checkout, and isolated sandbox payment gateway",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/app-api-server.mjs",
    "dev:payments": "node payment-sandbox-server.mjs",
    "start:api": "node server/app-api-server.mjs",
    "build": "vite build",
    "prebuild": "npm run check:resources",
    "check:resources": "node scripts/check-resource-filenames.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/dev.mjs",
    "start:payments": "node payment-sandbox-server.mjs",
    "backup:data": "node scripts/backup.mjs",
    "backup:cloud": "npm run backup:data && node scripts/backup-cloud.mjs",
    "restore:data": "node scripts/restore.mjs",
    "test:unit": "node --test tests/local-data.test.js tests/payment-sandbox.test.mjs tests/payment-ipn-integration.test.mjs tests/server-api.test.mjs tests/backup.test.mjs tests/backup-restore.test.mjs tests/backup-crypto.test.mjs tests/client-ip.test.mjs tests/demo-auth.test.mjs tests/cloud-backup.test.mjs tests/communication-service.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "bootstrap-icons": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "geist": "^1.9.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.2"
  }
}
