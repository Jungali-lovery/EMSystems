# Copy to /etc/emsystems/app-api.env and set ownership to root:emsystems, mode 0640.
PUBLIC_APP_ORIGIN=https://YOUR_DOMAIN
APP_ALLOWED_ORIGINS=https://YOUR_DOMAIN
PAYMENT_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_SECRET_IN_PAYMENT_ENV_AT_LEAST_32_CHARS
PAYMENT_API_INTERNAL_URL=http://127.0.0.1:5175

# Required for encrypted backup generation. Use 64 hex characters (32 random bytes).
EMSYSTEMS_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# One-time bootstrap only: set for first startup when the admin has no password credential,
# then remove this line/value from the environment file after successful provisioning.
EMSYSTEMS_BOOTSTRAP_ADMIN_PASSWORD=

# Set true on production only after OTP and privacy-consent flows are tested.
EMSYSTEMS_REQUIRE_PHONE_VERIFICATION=true
EMSYSTEMS_REQUIRE_DATA_CONSENT=true

# Resend transactional mail and password reset.
RESEND_API_KEY=
EMSYSTEMS_EMAIL_FROM=
EMSYSTEMS_PUBLIC_URL=https://YOUR_DOMAIN

# Twilio Verify; required when EMSYSTEMS_REQUIRE_PHONE_VERIFICATION=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM=

# Zalo ZNS; configure only after OA/template approval.
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_ACCESS_TOKEN_EXPIRES_AT=
ZALO_ZNS_APP_ID=
ZALO_ZNS_APP_SECRET=
ZALO_ZNS_REFRESH_TOKEN=
ZALO_ZNS_TEMPLATE_ID_ORDER=
EMSYSTEMS_ZALO_TOKEN_STATE_FILE=/var/lib/emsystems/zalo-zns-token.json

# Registered seller identity and e-commerce notification reference.
EMSYSTEMS_LEGAL_OPERATOR_NAME=
EMSYSTEMS_LEGAL_TAX_CODE=
EMSYSTEMS_LEGAL_BUSINESS_REGISTRATION=
EMSYSTEMS_LEGAL_BUSINESS_REGISTRATION_DATE=
EMSYSTEMS_LEGAL_BUSINESS_REGISTRATION_ISSUER=
EMSYSTEMS_LEGAL_REGISTERED_ADDRESS=
EMSYSTEMS_LEGAL_REPRESENTATIVE_NAME=
EMSYSTEMS_LEGAL_REPRESENTATIVE_TITLE=
EMSYSTEMS_LEGAL_HOTLINE=
EMSYSTEMS_LEGAL_EMAIL=
EMSYSTEMS_ECOMMERCE_NOTICE_ID=
EMSYSTEMS_ECOMMERCE_BADGE_URL=

# Cloudflare R2 / Amazon S3 off-site backup credentials.
EMSYSTEMS_S3_ENDPOINT=
EMSYSTEMS_S3_BUCKET=
EMSYSTEMS_S3_REGION=auto
EMSYSTEMS_S3_ACCESS_KEY_ID=
EMSYSTEMS_S3_SECRET_ACCESS_KEY=
EMSYSTEMS_S3_PREFIX=emsystems/backups

# Optional operational alert webhook; keep it secret.
EMSYSTEMS_ALERT_WEBHOOK_URL=
EMSYSTEMS_ALERT_WEBHOOK_TOKEN=

# Keep disabled until a provider contract, tax profile and API credentials exist.
EMSYSTEMS_EINVOICE_PROVIDER=none