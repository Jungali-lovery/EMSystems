# Copy to /etc/emsystems/payment.env and set ownership to root:emsystems, mode 0640.
PAYMENT_FRONTEND_URL=https://YOUR_DOMAIN
PAYMENT_PUBLIC_BASE_URL=https://YOUR_DOMAIN
APP_API_INTERNAL_URL=http://127.0.0.1:5176
PAYMENT_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_SECRET_IN_APP_API_ENV_AT_LEAST_32_CHARS

# MoMo sandbox/merchant credentials. Never expose these through VITE_* variables.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_STORE_ID=EMSystems
MOMO_PARTNER_NAME=EMSystems
MOMO_IPN_URL=https://YOUR_DOMAIN/api/payments/momo/ipn

# VNPAY sandbox/merchant credentials.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_IPN_CONFIGURED=false
VNPAY_RETURN_URL=https://YOUR_DOMAIN/api/payments/vnpay/return